digraph WBS {
    // Configuration générale du graphique
    rankdir=LR; // Orientation de gauche à droite (utilise TB pour haut en bas)
    node [shape=box, style=filled, fillcolor=lightblue, fontname="Arial"];
    edge [color=gray40];

    // Nœud racine (le projet)
    Project [label="Projet\nPick and place", shape=ellipse, fillcolor=gold];

    // Niveau 1 : Phases principales
    Phase1 [label="1. Instruction via Optitrack\nCalcul des instructions via les\ndonnées de la cages."];
    Phase2 [label="2. Asservissement du robot\nAsservissement du robot à partir\ndes instructions données."];
    Phase3 [label="3. Instruction via caméra\nCalcul des instructions via les\ndonnées de la caméra."];
    Phase4 [label="4. Phase de mise en commun\nLier chaque partie pour faire un\nrobot fonctionnel."];

    // Niveau 2 : Tâches sous chaque phase
    // Phase 1
    Task1_1 [label="Tâche 1.1\nDéfinition des objets à traquer"];
    Task1_2 [label="Tâche 1.2\nDéveloppement du code\npermettant de détecter lire les données\nenvoyées sur le réseau."];
    Task1_3 [label="Tâche 1.3\nConteneurisation du code."];

    // Phase 2
    Task2_1 [label="Tâche 2.1\nContrôle du bras robotique\nde manière manuelle."];
    Task2_2 [label="Tâche 2.2\nDéveloppement des algorithmes\nd'asservissement du bras."];
    Task2_3 [label="Tâche 2.3\nConteneurisation du code."];

    // Phase 3
    Task3_1 [label="Tâche 3.1\nDétermination du matériel\ninformatique nécessaire\npour la caméra."];
    Task3_2 [label="Tâche 3.2\nDéveloppement du code\npour extraire les objets\npertinents que la caméra détecte."];
    Task3_3 [label="Tâche 3.3\nDéveloppement des\nméthodes pour donner les\ninstructions au robot."]
    Task3_4 [label="Tâche 3.4\nConteneurisation du code."]

    // Niveau 3 : Sous-tâches (exemple pour une tâche)
    SubTask1_2_1 [label="Sous-tâche 1.2.1\nCalibration du robot pour déterminer\nles instructions à partir de l'optitrack."];
    SubTask1_2_2 [label="Sous-tâche 1.2.2\nMesure de l'erreur entre les\ninstructions et les coordonnées réelles\ndu robot."];
    SubTask1_2_3 [label="Sous-tâche 1.2.1\nMesure de l'erreur entre les\ninstructions de la caméra et\n celles calculées à partir de de l'Optitrack."];

    SubTask2_2_1 [label="Sous-tâche 2.2.1\nValidation à partir des\ninstructions de l'Optitrack."]

    SubTask3_3_1 [label="Sous-tâche 3.3.1\nValidation du\ncode à partir de la calibration\nissue de l'optitrack."]

    Task4_1 [label="Sous-tâche 4.1\nInterfacer le robot avec l'optitrack."]
    Task4_2 [label="Sous-tâche 4.2\nInterfacer le robot avec la caméra."]

    SubTask4_1 [label="Sous-tâche 4.1.1\nTester le robot en condition réelle."]
    SubTask4_2 [label="Sous-tâche 4.1.2\nTester le robot en condition réelle."]

    // Relations hiérarchiques
    Project -> Phase1;
    Project -> Phase2;
    Project -> Phase3;
    Project -> Phase4;

    Phase1 -> Task1_1;
    Phase1 -> Task1_2;
    Phase1 -> Task1_3;
    Task1_2 -> SubTask1_2_1;
    Task1_2 -> SubTask1_2_2;
    Task1_2 -> SubTask1_2_3;

    Phase2 -> Task2_1;
    Phase2 -> Task2_2;
    Task2_2 -> SubTask2_2_1
    Phase2 -> Task2_3;


    Phase3 -> Task3_1;
    Phase3 -> Task3_2;
    Phase3 -> Task3_3;
    Phase3 -> Task3_4;

    Task3_3 -> SubTask3_3_1

    Phase4 -> Task4_1 -> SubTask4_1;
    Phase4 -> Task4_2 -> SubTask4_2;

    // Style pour les sous-tâches
    SubTask1_2_1 [fillcolor=lightgreen];
    SubTask1_2_2 [fillcolor=lightgreen];
    SubTask1_2_3 [fillcolor=lightgreen];
    SubTask2_2_1 [fillcolor=lightgreen];
    SubTask3_3_1 [fillcolor=lightgreen];
    SubTask4_1 [fillcolor=lightgreen];
    SubTask4_2 [fillcolor=lightgreen];
}